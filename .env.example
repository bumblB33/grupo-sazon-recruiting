# Not ANTHROPIC_API_KEY: Claude Code in the same terminal reads that name
PROJECT_ANTHROPIC_API_KEY=
# Only for the bake-off (pip install -e ".[evals]")
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Shared secret this app owns; generate one, recruiters paste it in /recruiter/login
SCREENING_RECRUITER_API_KEY=
# Auth token verifies X-Twilio-Signature on the webhook; the API key authenticates outbound REST calls
SCREENING_TWILIO_AUTH_TOKEN=
SCREENING_TWILIO_ACCOUNT_SID=
SCREENING_TWILIO_API_KEY_SID=
SCREENING_TWILIO_API_KEY_SECRET=
SCREENING_TWILIO_WHATSAPP_FROM=+14155238886
SCREENING_TWILIO_OPENER_CONTENT_SID=
# The exact webhook URL entered in the Twilio console (https://<host>/webhook/whatsapp).
# Needed behind a tunnel or proxy, empty when Twilio reaches the app at that URL directly
SCREENING_TWILIO_WEBHOOK_URL=
# Local only
SCREENING_DEV_MODE=false
SWEEP_INTERVAL_SECONDS=300
