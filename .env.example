# Not ANTHROPIC_API_KEY: Claude Code in the same terminal reads that name
PROJECT_ANTHROPIC_API_KEY=
# Only for the bake-off (pip install -e ".[evals]")
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Recruiter login: they type their work email at /recruiter/login and click the link they receive.
# Session secret signs the cookie (python -c "import secrets; print(secrets.token_urlsafe(32))").
SCREENING_SESSION_SECRET=
# JSON list of email domains whose addresses enrol themselves on first login.
SCREENING_RECRUITER_EMAIL_DOMAINS=["gruposazon.com"]
# Login links go out through Twilio SendGrid from a verified sender.
SCREENING_SENDGRID_API_KEY=
SCREENING_LOGIN_EMAIL_FROM=
# Base URL in every login link, e.g. https://<host>. Required unless SCREENING_DEV_MODE is on, because the Host header is attacker-controlled.
SCREENING_PUBLIC_URL=
# Throttle on login emails: one per address per cooldown, and per client IP per window. Behind a proxy, set FORWARDED_ALLOW_IPS so the IP is the caller's.
# SCREENING_LOGIN_EMAIL_COOLDOWN_SECONDS=60
# SCREENING_LOGIN_REQUESTS_PER_IP=30
# SCREENING_LOGIN_IP_WINDOW_MINUTES=60
# Auth token verifies X-Twilio-Signature on the webhook; the API key authenticates outbound REST calls
SCREENING_TWILIO_AUTH_TOKEN=
SCREENING_TWILIO_ACCOUNT_SID=
SCREENING_TWILIO_API_KEY_SID=
SCREENING_TWILIO_API_KEY_SECRET=
SCREENING_TWILIO_WHATSAPP_FROM=+14155238886
SCREENING_TWILIO_OPENER_CONTENT_SID=
# The exact webhook URL entered in the Twilio console (https://<host>/webhook/whatsapp).
# Needed behind a tunnel or proxy, empty when Twilio reaches the app at that URL directly
SCREENING_TWILIO_WEBHOOK_URL=
# Local only
SCREENING_DEV_MODE=false
SWEEP_INTERVAL_SECONDS=300
